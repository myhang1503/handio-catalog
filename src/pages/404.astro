---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Không tìm thấy trang">
  <section class="container lost">
    <p class="eyebrow">404</p>
    <p class="lead">Trang bạn tìm không tồn tại hoặc đã được chuyển đi.</p>
    <a class="button" href="/">Xem bộ sưu tập</a>
  </section>
</BaseLayout>
<style>
  .lost { text-align: center; padding-block: 3rem; }
  .lead { color: var(--muted); margin: 0.4rem 0 2rem; }
</style>
