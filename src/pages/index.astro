---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { productPhoto } from '../lib/images';
import { SITE } from '../config';

const entries = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
const products = await Promise.all(
  entries.map(async (e) => ({
    slug: e.id,
    ...e.data,
    coverPhoto: await productPhoto(e.data.cover),
    hoverPhoto: e.data.images[0] ? await productPhoto(e.data.images[0].file) : undefined,
  })),
);
---
<BaseLayout title="Collection" image={products[0]?.coverPhoto.src}>
  <section class="intro container">
    <p class="eyebrow">{SITE.slogan}</p>
  </section>
  <section class="container" aria-label="Collection">
    <div class="grid">
      {products.map((p) => (
        <div class="item">
          <ProductCard
            href={`/products/${p.slug}/`}
            name={p.name}
            subtitle={p.subtitle}
            cover={p.coverPhoto}
            hover={p.hoverPhoto}
          />
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
<style>
  .intro { text-align: center; padding-block: 1rem 2.5rem; }
  .grid {
    --gap: clamp(10px, 2vw, 24px);
    --stagger: clamp(1.5rem, 6vw, 4rem);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--gap);
    padding-bottom: var(--stagger);
  }
  /* offset alternate columns for a staggered rhythm (transform keeps row heights even) */
  .item:nth-child(2n) { transform: translateY(var(--stagger)); }
  @media (min-width: 700px) {
    .grid { grid-template-columns: repeat(3, 1fr); }
    .item:nth-child(2n) { transform: none; }
    .item:nth-child(3n + 2) { transform: translateY(var(--stagger)); }
  }
  @media (min-width: 1100px) {
    .grid { grid-template-columns: repeat(4, 1fr); }
    .item:nth-child(3n + 2) { transform: none; }
    .item:nth-child(4n + 2), .item:nth-child(4n + 4) { transform: translateY(var(--stagger)); }
  }
</style>
